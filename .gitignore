# Data, LD scores, S-LDSC run files and logs live under the data root (AGA_DATA), never in the repository.
*.parquet
*.npz
*.sumstats
*.sumstats.gz
*.annot.gz
*.ldscore.gz
*.pgen
*.pvar
*.psam
*.bed.gz
*.log
__pycache__/
*.pyc
.ipynb_checkpoints/
# result files, the trait table of e20 and the figures are written by the pipeline and are not tracked
experiments/*/results/*
!experiments/*/results/.gitkeep
experiments/*/figures/
experiments/e20_gwas_panel/traits_exp3u.csv
figures/out/*
!figures/out/.gitkeep
# a second copy of the code to run in (tools/make_run_copy.py) and the report of verify/compare_results.py
repro_run/
verify/report*.md
